        "@types/node": "^15.12.2",
        "@typescript-eslint/parser": "^8.57.2",
        "chai": "^4.3.6",
        "cross-env": "^7.0.3",
        "eslint": "^10.1.0",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "nyc": "^15.1.0",
        "obsidian": "^1.12.3",
        "rollup": "^2.51.2",
        "rollup-plugin-copy": "^3.4.0",
        "ts-node": "^10.7.0",
        "tslib": "^2.3.0",
        "typescript": "^4.6.3"
    }
